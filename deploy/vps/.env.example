# 复制成 .env 后填写。生产环境建议直接用 systemd 的 EnvironmentFile。
# cp .env.example .env

# ---------- 服务 ----------
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
THANKS_PATH=/thanks
RATE_LIMIT_PER_HOUR=6

# ---------- 邮件通知（Resend）----------
# 注册 https://resend.com → 验证发信域名 → 建 API Key
# 不填也能用：线索照样落盘，只是没人给你发邮件
RESEND_API_KEY=
MAIL_TO=hi@example.com
MAIL_FROM="站点询盘 <lead@example.com>"

# ---------- 即时通知（可选）----------
# 填了就在收到线索时推一条消息。四选一：
#   wecom    企业微信群机器人
#   feishu   飞书自定义机器人
#   telegram Telegram Bot（需要同时填 TELEGRAM_CHAT_ID）
#   generic  任意接受 {"text":"..."} 的 Webhook
NOTIFY_WEBHOOK=
NOTIFY_WEBHOOK_KIND=wecom
TELEGRAM_CHAT_ID=
